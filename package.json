{
  "name": "brightshoremortgage",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:brightshore": "node scripts/run-with-brand.js brightshore expo start",
    "start:essex": "node scripts/run-with-brand.js essex expo start",
    "start:cornerstone": "node scripts/run-with-brand.js cornerstone expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "config:brightshore": "node scripts/run-with-brand.js brightshore npx expo config --json",
    "config:essex": "node scripts/run-with-brand.js essex npx expo config --json",
    "config:cornerstone": "node scripts/run-with-brand.js cornerstone npx expo config --json",
    "screenshots:app-store": "node ci_scripts/generate-app-store-screenshots.js",
    "screenshots:capture": "node scripts/capture-store-screenshots.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-navigation/bottom-tabs": "^7.4.8",
    "@react-navigation/native": "^7.1.18",
    "expo": "~54.0.37",
    "expo-font": "~14.0.12",
    "expo-print": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.9",
    "react-native-file-viewer": "^2.1.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@react-native/metro-config": "^0.82.1",
    "@types/react": "~19.1.0",
    "baseline-browser-mapping": "^2.10.27",
    "playwright": "^1.60.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-cookies/cookies",
          "react-native-file-viewer"
        ]
      }
    }
  }
}
