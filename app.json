{
  "expo": {
    "name": "BrightShore Mortgage",
    "slug": "brightshore-servicing",
    "version": "1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.brightshoremortgage.app"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.brightshoremortgage.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This allows BrightShore Mortgage and its website partners to use cookies and device identifiers for tracking across apps and websites."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e9d4eee-d490-453e-b619-17643137965f"
      }
    }
  }
}
